# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again


#loadrt [KINS]KINEMATICS
#loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
#
#loadrt pid names=pid.x,pid.y,pid.z,pid.s
#loadrt mux16 names=jogincr

#addf motion-command-handler   servo-thread
#addf motion-controller        servo-thread
#addf pid.x.do-pid-calcs       servo-thread
#addf pid.y.do-pid-calcs       servo-thread
#addf pid.z.do-pid-calcs       servo-thread
#addf pid.s.do-pid-calcs       servo-thread
#addf jogincr                  servo-thread
#
#
##  ---estop signals---
#
net estop-out     <=  iocontrol.0.user-enable-out
net estop-out     =>  iocontrol.0.emc-enable-in

#  ---Wago PLC ---
loadusr -W mb2hal config=mb2hal.ini

#  ---Classic Ladder---
loadrt classicladder_rt
addf classicladder.0.refresh servo-thread
loadusr classicladder custom.clp 



#  ---Classic Ladder Nets --
# Inputs
net tool-release-button          mb2hal.opr.i.SA123-TOOL-REL-BUTTON.bit            classicladder.0.in-00
net spindle-on-cmd               spindle.0.on                                      classicladder.0.in-01



# Outputs
net tool-hold                      mb2hal.opr.o.SA114-SPINDLE-HOLD-TOOL.bit          classicladder.0.out-00
net tool-release                   mb2hal.opr.o.SA115-SPINDLE-RELEASE-TOOL.bit       classicladder.0.out-01
net inverter-enable-contactor      mb2hal.cab.out.AS16-AS15.INVERTER_EN_CMD.bit      classicladder.0.out-02
net inverter-to-spindle-contactor  mb2hal.cab.out.AG144-SA13.SPINDLE_CONTACTOR.bit   classicladder.0.out-03
net spindle-air-purge              mb2hal.opr.o.SU11-SPINDLE-AIR-PURGE.bit           classicladder.0.out-04

net spindle-piston-p1-lower        mb2hal.opr.o.SA17-SPINDLE-P1-LOWER.bit              classicladder.0.out-05 
net spindle-piston-p1-raise        mb2hal.opr.o.SA16-SPINDLE-P1-RAISE.bit              classicladder.0.out-06 
net spindle-piston-p2-lower        mb2hal.opr.o.SA132-SPINDLE-P2-LOWER.bit             classicladder.0.out-07  
net spindle-piston-p2-raise        mb2hal.opr.o.SA131-SPINDLE-P2-RAISE.bit             classicladder.0.out-08  
net spindle-piston-p3-lower        mb2hal.opr.o.SA134-SPINDLE-P3-LOWER.bit             classicladder.0.out-09  
net spindle-piston-p3-raise        mb2hal.opr.o.SA133-SPINDLE-P3-RAISE.bit             classicladder.0.out-10 


# --- Machine Power ---
net machine-is-on => mb2hal.cab.out.AG113-AP12.MACHINE_POWER.bit


# Spindle Control

# Yaskawa Spindel Configuration
# Reg 0x001 - Control Word - WRITE
loadrt weighted_sum wsum_sizes=8
addf process_wsums servo-thread

net spin.0x001.w.00-fwd    => wsum.0.bit.0.in #forward
net spin.0x001.w.01-rev    => wsum.0.bit.1.in #reverse
net spin.0x001.w.02-cls_t3 => wsum.0.bit.2.in #closed term 3
net spin.0x001.w.03-cls_t4 => wsum.0.bit.3.in #closed term 4
net spin.0x001.w.04-cls_t5 => wsum.0.bit.4.in #closed term 5
net spin.0x001.w.05-cls_t6 => wsum.0.bit.5.in #closed term 6
net spin.0x001.w.06-cls_t7 => wsum.0.bit.6.in #closed term 7
net spin.0x001.w.07-cls_t8 => wsum.0.bit.7.in #closed term 8

net spin.0x001.w.00-fwd <= spindle.0.reverse 
net spin.0x001.w.01-rev <= spindle.0.forward

net spindle-control-word wsum.0.sum => mb2hal.spin.control-word.00.int

# Reg 0x001 - Control Word - READBACK
loadrt bitslice count=2 personality=32,32
addf bitslice.0 servo-thread
addf bitslice.1 servo-thread

loadrt conv_s32_u32 count=2
addf conv-s32-u32.0 servo-thread
addf conv-s32-u32.1 servo-thread

# Read a S32 --> Convert to U32 for Bitslice
net spindle-control-word-s32 mb2hal.spin.control-word-read.00.int => conv-s32-u32.0.in 
net spindle-control-word-u32 conv-s32-u32.0.out => bitslice.0.in

net spin.0x001.r.00-fwd     <= bitslice.0.out-00 #Forward
net spin.0x001.r.01-rev     <= bitslice.0.out-01 #Reverse
net spin.0x001.r.02-cls_t3  <= bitslice.0.out-02 #Closed External Term 3
net spin.0x001.r.03-cls_t4  <= bitslice.0.out-03 #Closed External Term 4
net spin.0x001.r.04-cls_t5  <= bitslice.0.out-04 #Closed External Term 5
net spin.0x001.r.05-cls_t6  <= bitslice.0.out-05 #Closed External Term 6
net spin.0x001.r.06-cls_t7  <= bitslice.0.out-06 #Closed External Term 7
net spin.0x001.r.07-cls_t8  <= bitslice.0.out-07 #Closed External Term 8


# Reg 0x002 - Refrence Frequency / Output Frequency
loadrt conv_float_s32 count=1
addf conv-float-s32.0 servo-thread

loadrt scale count=1
addf scale.0 servo-thread
setp scale.0.gain 20.0

net spindle-cmd-freq-scale       spindle.0.speed-out-rps-abs => scale.0.in
net spindle-cmd-freq-float       scale.0.out                 => conv-float-s32.0.in 
net spindle-cmd-freq-s32         conv-float-s32.0.out        => mb2hal.spin.freq-ref.00.int


# Reg 0x010 - Status Signal - READ
# loadrt bitslice count=1 personality=32
#addf bitslice.0 servo-thread

#loadrt conv_s32_u32 count=1
#addf conv-s32-u32.0 servo-thread

# Read a S32 --> Convert to U32 for Bitslice
net spindle-status-word-s32 mb2hal.spin.status-word.00.int => conv-s32-u32.1.in 
net spindle-status-word-u32 conv-s32-u32.1.out => bitslice.1.in

net spin.0x010.00-run_cmd    <= bitslice.1.out-00 #Run Command
net spin.0x010.01-at_zero    <= bitslice.1.out-01 #At Zero Speed
net spin.0x010.02-rev_op     <= bitslice.1.out-02 #Reverse Operation
net spin.0x010.03-rst_sig_in <= bitslice.1.out-03 #Reset Sig Input
net spin.0x010.04-spd_agreed <= bitslice.1.out-04 #Speed Agreed
net spin.0x010.05-drv_ready  <= bitslice.1.out-05 #Drive Ready
net spin.0x010.06-flt_minor  <= bitslice.1.out-06 #Minor Fault
net spin.0x010.07-flt_major  <= bitslice.1.out-07 #Major Fault
net spin.0x010.08-ret_zer    <= bitslice.1.out-08 #Returns zeros
net spin.0x010.09-ret_zer    <= bitslice.1.out-09 #Returns zeros
net spin.0x010.10-ret_zer    <= bitslice.1.out-10 #Returns zeros
net spin.0x010.11-ret_zer    <= bitslice.1.out-11 #Returns zeros
net spin.0x010.12-ret_zer    <= bitslice.1.out-12 #Returns zeros
net spin.0x010.13-ret_zer    <= bitslice.1.out-13 #Returns zeros
net spin.0x010.14-ret_zer    <= bitslice.1.out-14 #Returns zeros
net spin.0x010.15-ret_zer    <= bitslice.1.out-15 #Returns zeros


# Reg 0x021 - Output Frequency
loadrt conv_s32_float count=1
addf conv-s32-float.0 servo-thread

net spindle-freq-act-s32   mb2hal.spin.0x021.output-freq.00.int => conv-s32-float.0.in
net spindle-freq-act-float conv-s32-float.0.out                 => spindle.0.speed-in


